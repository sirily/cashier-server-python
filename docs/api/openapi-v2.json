        ],
        "title": "XactRequest",
        "type": "object"
      },
      "XactResponse": {
        "properties": {
          "rejected": {
            "description": "Per-item rejections; mixed batches still return HTTP 200.",
            "items": {
              "$ref": "#/components/schemas/XactRejected"
            },
            "title": "Rejected",
            "type": "array"
          },
          "synchronized": {
            "description": "Newly committed and already-equivalent cashier_ids.",
            "items": {
