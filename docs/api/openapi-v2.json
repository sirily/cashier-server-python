      "XactRequest": {
        "properties": {
          "transactions": {
            "description": "Up to 100 completed * Beancount transaction strings, each with stable cashier_id metadata.",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Transactions",
            "type": "array"
          }
        },
        "required": [
