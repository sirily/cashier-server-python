          "408": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request body receive deadline exceeded (15 seconds)."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Body exceeds 1 MiB or query string exceeds 64 KiB."
          },
          "503": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Uvicorn connection/task admission limit exceeded, before the application handles health."
          }
        },
        "security": [],
        "summary": "Public lightweight health check"
      }
    },
    "/infrastructure": {
      "get": {
        "description": "Build the standalone source-preserving root ledger for offline PWA parsing.\n\n`file_path` must be exactly the configured BEANCOUNT_FILE basename (for example\n`main.bean`), never a client-selected included file. Includes/globs are resolved\nserver-side; unchanged source directives stay verbatim and Python plugin output\nis materialized only under the snapshot export policy. Exact `@@` total prices\nare preserved in storage and snapshot, never converted to rounded `@` unit prices.\nBuild errors fail closed with `detail: {message, errors: [string]}`, never raw source.\nCapture limits: 16 MiB per file, 64 MiB captured/expanded sources, 4096 files/include\nvisits, 64 include levels. Reads reject unsafe paths and symlinks. Only the configured\nroot is exposed; individual included/manual files and HTTP glob requests get 403.",
        "operationId": "infrastructure_file_infrastructure_get",
        "parameters": [
          {
            "description": "Required configured BEANCOUNT_FILE basename only; no arbitrary file access.",
            "in": "query",
            "name": "file_path",
            "required": true,
            "schema": {
              "description": "Required configured BEANCOUNT_FILE basename only; no arbitrary file access.",
              "examples": [
                "main.bean"
              ],
              "title": "File Path",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResponse"
                }
              }
            },
            "description": "Configured root snapshot, not arbitrary file access."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request, control characters, or path longer than 1024 characters."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid deployment-scoped bearer token.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "const": "Bearer",
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Absolute, hidden, traversal, glob, or non-root path rejected."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Empty path has no file component."
          },
          "408": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request body receive deadline exceeded (15 seconds)."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Body exceeds 1 MiB or query string exceeds 64 KiB."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotBuildErrorResponse"
                }
              }
            },
            "description": "Snapshot build failure (detail.message/errors), or request validation (detail array)."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing server configuration or a safe ledger pipeline/filesystem failure."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Server token not configured or all four heavy-operation slots busy. Uvicorn may instead return plain text when its 64-connection concurrency limit is reached."
          }
        },
        "security": [
          {
            "CashierBearer": []
          }
        ],
        "summary": "Export the configured root ledger snapshot"
      }
    },
