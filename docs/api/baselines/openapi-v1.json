  "info": {
    "description": "Beancount synchronization server for Cashier PWA",
    "title": "Cashier Server",
    "version": "0.14.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "Execute read-only BQL against the preloaded server ledger.\n\nThe optional `query` parameter remains backward compatible: absent or empty text\nreturns HTTP 200 `{\"error\":\"No query provided\"}`. Results are arbitrary JSON array\nrows, not objects keyed by column names; existing Decimal-to-JSON-number encoding\nis preserved. At most 10,000 rows and 8 MiB JSON are returned.\n\nEvery SELECT, including nested SELECTs, needs an explicit `accounts` or\n`transactions` source (`#accounts` / `#transactions` also work, as do subqueries\nwhose SELECTs have allowed explicit sources). The sole exception is one whole\ntop-level AST equivalent to `SELECT sum(number), currency, account ORDER BY account`:\nit implicitly reads postings grouped by currency/account and returns rows\n`[sum as JSON number, currency, account]`. No other implicit or explicit postings\naccess is allowed; wrapping or extending that special query is not allowed.\n\nCurrent Sync forms include `SELECT account FROM #accounts WHERE close IS NULL ORDER BY account`\nand `SELECT DISTINCT COALESCE(payee, narration) AS payee FROM transactions ORDER BY payee`.\nMutations, external sources, other tables, PRINT/JOURNAL/BALANCES, expression-based\nsources and OPEN/CLOSE/CLEAR qualifiers are rejected. BQL is not a write channel.\n\nLimits: 16 KiB UTF-8 query, AST 512 nodes/depth 32, 5 s wall deadline and 5 s CPU,\n1 GiB worker memory, 64 MiB serialized dataset, four shared heavy-operation slots.\nAll requests have a 1 MiB body, 64 KiB query string and 15 s receive deadline;\nUvicorn admits at most 64 concurrent connections/tasks.",
        "operationId": "index__get",
        "parameters": [
          {
            "description": "Optional BQL text; the limit is 16 KiB UTF-8 bytes, not characters.",
            "examples": {
              "accounts": {
                "value": "SELECT account FROM #accounts WHERE close IS NULL ORDER BY account"
              },
              "balances": {
                "value": "SELECT sum(number), currency, account ORDER BY account"
              },
              "payees": {
                "value": "SELECT DISTINCT COALESCE(payee, narration) AS payee FROM transactions ORDER BY payee"
              }
            },
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional BQL text; the limit is 16 KiB UTF-8 bytes, not characters.",
              "title": "Query"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BqlResponse"
                }
              }
            },
            "description": "JSON array rows; absent/empty query returns an error envelope."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request, BQL syntax/source/AST, or BQL query/dataset/row/JSON size limit."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid deployment-scoped bearer token.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "const": "Bearer",
                  "type": "string"
                }
              }
            }
          },
          "408": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request body receive deadline exceeded (15 seconds)."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Body exceeds 1 MiB or query string exceeds 64 KiB."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BqlValidationErrorResponse"
                }
              }
            },
            "description": "BQL execution/CPU deadline (string detail), or FastAPI request validation (detail array)."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing server configuration or a safe ledger pipeline/filesystem failure."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Server token not configured or all four heavy-operation slots busy. Uvicorn may instead return plain text when its 64-connection concurrency limit is reached."
          }
        },
        "security": [
          {
            "CashierBearer": []
          }
        ],
        "summary": "Execute a read-only BQL query"
      }
    },
